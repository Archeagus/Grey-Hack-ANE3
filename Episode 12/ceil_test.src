// Ceil() test script
// Test the math

p = 6 // p=pages
data = [1, 3, 6, 7, 15, 35]
dec = [0.1, 1.0, 1.1, 3.9]

print("Greyscript Ceil() Math Test")
print("===========================")
print("")

// Raw division
print("Raw Division / Ceil Tests")
for d in data
	print(d + " / " + p + " = " + (d/p))
	print("Ceil(" + d + "/" + p + ") = " + ceil(d/p))
end for
print("")

//Ceil() decimal test
print("Ceil() Decimal Test")
for d in dec
	print("Ceil(" + d + ") = " + ceil(d))
end for
print("")